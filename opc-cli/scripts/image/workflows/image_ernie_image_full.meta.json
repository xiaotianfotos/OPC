{
  "alias": "ernie-full",
  "description": "Ernie-Image full mode (non-turbo). 50 steps, cfg=4. Supports structured JSON prompts (auto-converted to text) and negative prompts. Prompt enhancement disabled.",
  "params": {
    "prompt": {
      "node": "88:78",
      "field": "value",
      "type": "string",
      "required": true,
      "description": "Text or JSON prompt for image generation"
    },
    "negative_prompt": {
      "node": "88:72",
      "field": "text",
      "type": "string",
      "default": "",
      "description": "Negative prompt — things to avoid in the image"
    },
    "width": {
      "node": "88:71",
      "field": "width",
      "type": "int",
      "default": 1024
    },
    "height": {
      "node": "88:71",
      "field": "height",
      "type": "int",
      "default": 1024
    },
    "steps": {
      "node": "88:70",
      "field": "steps",
      "type": "int",
      "default": 50
    },
    "cfg": {
      "node": "88:70",
      "field": "cfg",
      "type": "float",
      "default": 4
    },
    "seed": {
      "node": "88:70",
      "field": "seed",
      "type": "int",
      "default": -1,
      "description": "-1 = random seed"
    },
    "batch_size": {
      "node": "88:71",
      "field": "batch_size",
      "type": "int",
      "default": 1,
      "description": "Number of images to generate per batch"
